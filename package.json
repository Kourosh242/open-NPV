{
  "name": "open-npv",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Open NPV — local-first NPVT/NPVS configuration extractor. Persian RTL, offline-ready PWA, no uploads.",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Kourosh",
    "url": "https://github.com/kourosh242"
  },
  "homepage": "https://kourosh242.github.io/open-npv/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kourosh242/open-npv.git"
  },
  "bugs": {
    "url": "https://github.com/kourosh242/open-npv/issues"
  },
  "keywords": [
    "npvt",
    "npvs",
    "napsternetv",
    "npv-tunnel",
    "vless",
    "vmess",
    "xray",
    "pwa",
    "offline",
    "persian",
    "rtl"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "tables": "node scripts/generate-tables.mjs",
    "build": "npm run tables && node scripts/build.mjs",
    "typecheck": "npm run tables && tsc --noEmit",
    "test": "npm run tables && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "verify": "npm run check && npm run test:browser",
    "preview": "node scripts/serve.mjs",
    "release:zip": "node scripts/release-zip.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0"
  }
}
